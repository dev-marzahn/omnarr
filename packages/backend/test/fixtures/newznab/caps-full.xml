<?xml version="1.0" encoding="UTF-8"?>
<!-- Hand-written. Caps with explicit supportedParams, a page limit, a site category under TV and an apilimits element. -->
<caps>
  <server version="1.0" title="Example Indexer" strapline="Example" email="info@indexer.example" url="https://indexer.example/"/>
  <limits max="100" default="50"/>
  <newznab:apilimits xmlns:newznab="http://www.newznab.com/DTD/2010/feeds/attributes/" apicurrent="12" apimax="100" grabcurrent="0" grabmax="25"/>
  <registration available="no" open="no"/>
  <searching>
    <search available="yes" supportedParams="q"/>
    <tv-search available="yes" supportedParams="q,rid,tvdbid,tmdbid,season,ep"/>
    <movie-search available="yes" supportedParams="q,imdbid"/>
    <audio-search available="no" supportedParams="q"/>
  </searching>
  <categories>
    <category id="2000" name="Movies">
      <subcat id="2040" name="HD"/>
      <subcat id="2045" name="UHD"/>
    </category>
    <category id="5000" name="TV">
      <subcat id="5040" name="HD"/>
      <subcat id="5070" name="Anime"/>
      <subcat id="100040" name="TV HEVC"/>
    </category>
    <category id="7000" name="Other">
      <subcat id="7010" name="Misc"/>
    </category>
    <category id="100100" name="Site Movies Extra"/>
  </categories>
</caps>
