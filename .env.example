# omnarr's settings. Every one is optional: copy this file to .env and
# uncomment what you change. An empty value (VAR=) counts as unset. After a
# change, run `docker compose up -d`.

# --- Addresses (docs/install.md, "Remote access") ---
# Set all three, or none. Unset, the browser uses its own address with each port.
# With these set, sign-in works only at OMNARR_WEB_URL.
# OMNARR_WEB_URL=https://omnarr.example.net
# OMNARR_CONVEX_URL=https://api.omnarr.example.net
# OMNARR_CONVEX_SITE_URL=https://auth.omnarr.example.net
# Jellyfin as your devices reach it, for the "Open in Jellyfin" links. Unset: this browser's address on OMNARR_JELLYFIN_PORT.
# OMNARR_JELLYFIN_URL=https://jellyfin.example.net

# --- Published ports ---
# OMNARR_WEB_PORT=3000
# OMNARR_CONVEX_PORT=3210
# OMNARR_CONVEX_SITE_PORT=3211
# OMNARR_JELLYFIN_PORT=8096
# The address the web, Convex and Jellyfin ports listen on; 127.0.0.1 behind a reverse proxy on this host.
# OMNARR_BIND_ADDRESS=0.0.0.0
# qBittorrent's peer port, on all addresses (direct layout only).
# OMNARR_PEER_PORT=6881

# --- First run ---
# The setup password the first-run page asks for. Unset: setup generates one and prints it once
# (docker compose logs setup; again with docker compose run --rm setup show-setup-password).
# OMNARR_SETUP_PASSWORD=

# --- Storage ---
# The media folder: downloads, staging, originals and the libraries, on one filesystem.
# OMNARR_DATA_DIR=./data
# The user and group that own it and run the worker, the clients and Jellyfin.
# PUID=1000
# PGID=1000

# --- Other ---
# The daily check for a new release on GitHub: on or off.
# OMNARR_UPDATE_CHECK=on
# Your own TMDB Read Access Token; unset uses the built-in one.
# TMDB_API_TOKEN=
# The VPN layout: COMPOSE_FILE=compose.yml:compose.vpn.yml
# COMPOSE_FILE=compose.yml
# Restore and downgrade only (docs/install.md, "Backups"): an export in ./backups to import into an empty deployment.
# CONVEX_RELEASE_SNAPSHOT=/backups/<file>.zip
